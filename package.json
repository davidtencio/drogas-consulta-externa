{
  "name": "drogas-consulta-externa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:release": "node scripts/build-release.mjs",
    "build:demo": "node scripts/demo-preview.mjs build",
    "start:demo": "node scripts/demo-preview.mjs start",
    "check:release": "node scripts/build-release.mjs --check",
    "smoke:release": "node scripts/smoke-release.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "vitest run app/components/accessibility.test.tsx app/components/AccessibleDialog.test.tsx app/components/InventoryPanel.test.tsx app/components/workflowsAccessibility.test.tsx app/components/Login.test.tsx app/components/MovementsTab.test.tsx app/components/ArqueoScreen.test.tsx app/themeContrast.test.ts",
    "test:release": "node --test scripts/release.test.mjs",
    "test:rules": "firebase emulators:exec --config firebase.validation.json --only firestore --project demo-consulta-externa-design \"node --test scripts/firestore.validation.test.mjs\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.1",
    "@emnapi/runtime": "1.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
